{
  "name": "foundu",
  "version": "1.0.0",
  "private": true,
  "description": "FoundU: smart, secure lost and found for every campus (CSC490 Software Engineering, LAU, Fall 2026)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "db:demo": "npm run db:demo --workspace server",
    "test": "npm test --workspace server",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0"
  }
}

# Copy to .env and adjust.  Never commit .env.
PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/foundu
# Long random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
DATA_KEY=change-me-64-hex-characters-for-aes-256-gcm-0000000000000000000000
CLIENT_URL=http://localhost:5173
# Email: leave SMTP_HOST empty to write emails to server/outbox/ instead of sending them (development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FoundU <no-reply@foundu.app>"
# NFR-9: set both to serve the API over HTTPS (TLS 1.2 or later); leave empty for the local demo over HTTP
TLS_CERT=
TLS_KEY=
# NFR-11.2: requests per minute per user (100 unless set)
RATE_LIMIT_PER_MINUTE=

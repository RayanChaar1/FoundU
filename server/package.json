{
  "name": "foundu-server",
  "version": "1.0.0",
  "private": true,
  "description": "FoundU REST API (Node.js, Express, PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:reset": "node --env-file-if-exists=.env src/db/migrate.js --reset && node --env-file-if-exists=.env src/db/seed.js",
    "db:demo": "node --env-file-if-exists=.env src/db/demo.js",
    "test": "jest --runInBand",
    "idp": "node dev/idp.js",
    "smtp": "node dev/smtp.js",
    "perf:seed": "node --env-file-if-exists=.env perf/seed.js",
    "perf:search": "node --env-file-if-exists=.env perf/search.js",
    "perf:match": "node --env-file-if-exists=.env perf/match.js",
    "perf:load": "node --env-file-if-exists=.env perf/load.js"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "globalTeardown": "./tests/globalTeardown.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
